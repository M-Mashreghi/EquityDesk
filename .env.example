# EquityDesk example configuration. Copy to `.env` and fill in real values locally.
# Never commit real credentials. Process environment variables override `.env`.

# Runtime environment: development | test | production
EQUITYDESK_ENV=development
EQUITYDESK_DB_PATH=data/equitydesk.db
EQUITYDESK_DATA_DIR=data
EQUITYDESK_CACHE_DIR=data/cache
# Optional: curated security master JSON (defaults to data/fixtures/security_master.json)
EQUITYDESK_SECURITY_MASTER_PATH=
# DEBUG | INFO | WARNING | ERROR | CRITICAL
EQUITYDESK_LOG_LEVEL=INFO
# json | text
EQUITYDESK_LOG_FORMAT=json

# SEC EDGAR fair-access policy: descriptive User-Agent with a contact e-mail (required in production)
SEC_USER_AGENT=
SEC_MAX_REQUESTS_PER_SECOND=5

# LLM provider: fake (deterministic, offline) | anthropic
LLM_PROVIDER=fake
# e.g. claude-opus-5-5 (requires `pip install -e ".[llm]"`)
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Optional: USD per million tokens, used only for run cost telemetry
LLM_COST_INPUT_PER_MTOK=
LLM_COST_OUTPUT_PER_MTOK=

# Optional alert webhook (Phase 6)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Dashboard -> API base URL
EQUITYDESK_API_URL=http://localhost:8000

# Watchlist scheduler: seconds between ticks
EQUITYDESK_SCHEDULER_TICK_SECONDS=300
